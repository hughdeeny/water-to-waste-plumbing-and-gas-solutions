---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqList from '../../components/FaqList.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import {
	PHONE,
	PHONE_TEL,
	EMAIL_MAILTO,
	BUSINESS_NAME,
	SHORT_NAME,
	QUALIFICATION,
	LICENCE,
	INSURANCE,
	ABN,
	SITE_URL,
	services,
} from '../../data/site';
import { servicePages, getServiceTitle } from '../../data/servicePages';

export function getStaticPaths() {
	return servicePages.map((page) => ({
		params: { slug: page.slug },
		props: { page },
	}));
}

const { page } = Astro.props;
const summary = services.find((service) => service.slug === page.slug);
const related = page.relatedSlugs
	.map((slug) => ({
		slug,
		title: getServiceTitle(slug),
		description: services.find((service) => service.slug === slug)?.description,
	}))
	.filter((item) => item.title);

const canonical = `${SITE_URL}/services/${page.slug}/`;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${SITE_URL}/`,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Services',
			item: `${SITE_URL}/#services`,
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: page.title,
			item: canonical,
		},
	],
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: page.title,
	description: page.metaDescription,
	url: canonical,
	provider: {
		'@type': 'PlumbingService',
		name: BUSINESS_NAME,
		telephone: PHONE_TEL.replace('tel:', ''),
		url: SITE_URL,
	},
	areaServed: [
		'Adelaide Hills',
		'Murray Bridge',
		'Metropolitan Adelaide',
		'Totness',
	],
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: page.faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: faq.answer,
		},
	})),
};
---

<BaseLayout
	title={page.metaTitle}
	description={page.metaDescription}
	canonical={canonical}
	ogTitle={page.metaTitle}
	ogDescription={page.metaDescription}
	jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
>
	<Header />
	<main>
		<section class="section service-page">
			<div class="container service-page__layout">
				<Breadcrumbs
					items={[
						{ label: 'Home', href: '/' },
						{ label: 'Services', href: '/#services' },
						{ label: page.title },
					]}
				/>

				<div class="service-page__intro">
					{
						summary && (
							<div class="service-page__icon" aria-hidden="true">
								<ServiceIcon name={summary.icon} />
							</div>
						)
					}
					<p class="section-label">Plumbing Services</p>
					<h1 class="section-title">{page.h1}</h1>
					<p class="service-page__lead">{page.intro}</p>
					<div class="btn-group">
						<a href={PHONE_TEL} class="btn btn--primary btn--lg">Call {PHONE}</a>
						<a
							href={`${EMAIL_MAILTO}?subject=${encodeURIComponent(`Quote request: ${page.title}`)}`}
							class="btn btn--outline btn--lg"
						>
							Request a Quote
						</a>
					</div>
				</div>

				{
					page.sections.map((section) => (
						<section class="service-page__section">
							<h2 class="service-page__h2">{section.heading}</h2>
							{section.paragraphs.map((paragraph) => (
								<p class="service-page__text">{paragraph}</p>
							))}
							{section.list && (
								<>
									{section.listIntro && (
										<p class="service-page__text">{section.listIntro}</p>
									)}
									<ul class="service-page__list">
										{section.list.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</>
							)}
						</section>
					))
				}

				<section class="service-page__section">
					<h2 class="service-page__h2">Related services</h2>
					<p class="service-page__text">
						These related services are often considered alongside {page.title.toLowerCase()}:
					</p>
					<ul class="service-page__related">
						{
							related.map((item) => (
								<li>
									<a href={`/services/${item.slug}/`}>{item.title}</a>
									{item.description && <span>{item.description}</span>}
								</li>
							))
						}
					</ul>
				</section>

				<section class="service-page__section">
					<h2 class="service-page__h2">Frequently asked questions</h2>
					<FaqList items={page.faqs} />
				</section>

				<section class="service-page__trust">
					<h2 class="service-page__h2">Why choose {SHORT_NAME}</h2>
					<p class="service-page__text">
						{BUSINESS_NAME} is focused on service and reliability for customers across the
						Adelaide Hills, Murray Bridge and metropolitan Adelaide. {QUALIFICATION}, licence{' '}
						{LICENCE}, {INSURANCE}, ABN {ABN}.
					</p>
					<div class="btn-group">
						<a href={PHONE_TEL} class="btn btn--primary btn--lg">Call {PHONE}</a>
						<a href="/#contact" class="btn btn--outline btn--lg">Request a Quote</a>
					</div>
				</section>
			</div>
		</section>
		<FinalCTA />
	</main>
	<Footer />
</BaseLayout>
