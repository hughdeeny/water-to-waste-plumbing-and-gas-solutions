---
import { PHONE, PHONE_TEL } from '../data/site';
---

<section class="emergency">
	<div class="container emergency__inner">
		<h2 class="emergency__title">Plumbing Problem That Needs Attention Now?</h2>
		<p class="emergency__text">
			Leaks, blocked drains, hot water problems and gas issues can get worse quickly.
			Speak directly with a local plumber and get clear advice on the next step.
		</p>
		<a href={PHONE_TEL} class="btn btn--dark btn--lg">Call {PHONE}</a>
	</div>
</section>
