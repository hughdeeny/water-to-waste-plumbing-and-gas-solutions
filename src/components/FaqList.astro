---
interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-list">
	{
		items.map((item) => (
			<details class="faq-item">
				<summary class="faq-item__question">{item.question}</summary>
				<p class="faq-item__answer">{item.answer}</p>
			</details>
		))
	}
</div>
