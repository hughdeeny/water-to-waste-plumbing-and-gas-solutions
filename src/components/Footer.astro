---
import { BUSINESS_NAME, PHONE, PHONE_TEL, EMAIL, services } from '../data/site';
import SocialLinks from './SocialLinks.astro';
---

<footer class="footer">
	<div class="container footer__grid">
		<div>
			<p class="footer__brand">{BUSINESS_NAME}</p>
			<p class="footer__tagline">Plumbing & Gas Services</p>
			<p class="footer__tagline">Hahndorf, SA, Australia</p>
			<p style="margin-top: 1rem;">
				Phone: <a href={PHONE_TEL} class="footer__phone">{PHONE}</a>
			</p>
			<p>
				Email: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			</p>
			<SocialLinks />
		</div>

		<div>
			<p class="footer__heading">Services</p>
			<ul class="footer__links">
				{services.map((service) => <li>{service.title}</li>)}
			</ul>
		</div>

		<div>
			<p class="footer__heading">Quick Links</p>
			<ul class="footer__links">
				<li><a href="#services">Services</a></li>
				<li><a href="#about">About</a></li>
				<li><a href="#areas">Areas</a></li>
				<li><a href="#contact">Contact</a></li>
				<li><a href={PHONE_TEL}>Call {PHONE}</a></li>
			</ul>
		</div>
	</div>
</footer>
