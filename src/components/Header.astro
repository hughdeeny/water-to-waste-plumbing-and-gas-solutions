---
import { PHONE, PHONE_TEL, services } from '../data/site';
---

<header class="header">
	<div class="container header__inner">
		<a href="/" class="header__logo">
			Water to <span>Waste</span> Plumbing & Gas Solutions
		</a>

		<nav class="header__nav" aria-label="Main navigation">
			<div class="nav-dropdown">
				<a href="/#services" class="nav-dropdown__trigger">
					Services
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
						<polyline points="6 9 12 15 18 9" />
					</svg>
				</a>
				<ul class="nav-dropdown__menu" role="list">
					{
						services.map((service) => (
							<li>
								<a href={`/services/${service.slug}/`}>{service.title}</a>
							</li>
						))
					}
				</ul>
			</div>
			<a href="/#about">About</a>
			<a href="/#areas">Areas</a>
			<a href="/#contact">Contact</a>
		</nav>

		<a href={PHONE_TEL} class="btn btn--primary header__cta">
			Call {PHONE}
		</a>

		<button
			class="header__menu-btn"
			id="menu-btn"
			type="button"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</div>

	<nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
		<div class="mobile-nav__services">
			<button
				type="button"
				class="mobile-nav__services-toggle"
				id="services-toggle"
				aria-expanded="false"
				aria-controls="mobile-services"
			>
				Services
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
					<polyline points="6 9 12 15 18 9" />
				</svg>
			</button>
			<ul class="mobile-nav__services-list" id="mobile-services" hidden>
				<li>
					<a href="/#services">View services overview</a>
				</li>
				{
					services.map((service) => (
						<li>
							<a href={`/services/${service.slug}/`}>{service.title}</a>
						</li>
					))
				}
			</ul>
		</div>
		<a href="/#about">About</a>
		<a href="/#areas">Areas</a>
		<a href="/#contact">Contact</a>
		<a href={PHONE_TEL} class="btn btn--primary" style="margin-top: 1rem; width: 100%;">
			Call {PHONE}
		</a>
	</nav>
</header>
